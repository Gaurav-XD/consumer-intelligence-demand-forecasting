# Generated datasets (retain empty directory markers)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated models: keep only the tuned models required by the inference API
models/*
!models/.gitkeep
!models/churn/
models/churn/*
!models/churn/tuned_best_model.joblib
!models/forecasting/
models/forecasting/*
!models/forecasting/tuned_best_model.joblib

# Generated reports: keep only the tuned summaries required by the API
reports/*
!reports/.gitkeep
!reports/churn_tuning_summary.json
!reports/forecasting_tuning_summary.json

# Notebook checkpoint and local tooling state
.python-version.local
